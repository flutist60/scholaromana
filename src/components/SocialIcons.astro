---
<ul class={`social ${cls}`}>
  {socials.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
        <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true"><path d={paths[s.icon]} fill="currentColor" /></svg>
      </a>
    </li>
  ))}
</ul>
<style>
  .social { list-style: none; margin: 0; padding: 0; display: flex; gap: 14px; align-items: center; }
  .social a { color: #7a7a7a; display: block; transition: color 0.2s; }
  .social a:hover { color: var(--accent); }
  .social svg { display: block; }
</style>
