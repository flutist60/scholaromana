---
import PostView from '../../../views/PostView.astro';
import { getPosts, slugOf } from '../../../lib/blog';
export async function getStaticPaths() {
  return (await getPosts('it')).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props;
---
<PostView post={post} lang="it" />
