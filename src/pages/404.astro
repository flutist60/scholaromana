---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found | Schola Romana Ensemble">
  <section class="nf wrap">
    <h1 class="display">404</h1>
    <p>The page you are looking for does not exist. / La pagina che cerchi non esiste.</p>
    <p><a class="btn" href="/">Home</a> <a class="btn" href="/it/">Home (IT)</a></p>
  </section>
</Base>
<style>
  .nf { text-align: center; padding: 100px 16px 120px; }
  .nf h1 { font-size: 80px; color: var(--ink); }
  .nf .btn { margin: 6px; }
</style>
