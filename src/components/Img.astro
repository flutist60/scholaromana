---
import { Image } from 'astro:assets';
import { getImg } from '../lib/images';

interface Props {
  src: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  style?: string;
  title?: string;
}
const { src, alt = '', widths, sizes = '100vw', class: cls, loading = 'lazy', style, title } = Astro.props;
const meta = getImg(src)!;
const w = (widths ?? [480, 800, 1200, 1600, 2400]).filter((x) => x <= meta.width);
if (!w.length) w.push(meta.width);
---
<Image src={meta} alt={alt} widths={w} sizes={sizes} class={cls} loading={loading} style={style} title={title} format={meta.format === 'png' ? 'png' : 'webp'} quality={80} />
