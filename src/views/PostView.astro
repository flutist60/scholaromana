---
import Base from '../layouts/Base.astro';
import BlogNav from '../components/BlogNav.astro';
import PostCard from '../components/PostCard.astro';
import Img from '../components/Img.astro';
import { render } from 'astro:content';
import { getPosts, fmtDate, postUrl, translationOf, type Post } from '../lib/blog';
import { localize, ui, type Lang } from '../data/site';
interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'it' : 'en';
const tr = await translationOf(post, other);
const alternates = { [lang]: postUrl(post, lang), [other]: tr ? postUrl(tr, other) : localize('/blog', other) };
const recent = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 3);
---
<Base lang={lang} title={`${d.title} | Schola Romana`} description={d.excerpt} alternates={alternates}>
  <div class="blog">
    <BlogNav lang={lang} />
    <article class="wrap post">
      <div class="post-inner">
        <p class="meta">
          <a href={localize('/members-area/stefano-sabene/profile', lang)} class="author">
            <Img src="stefano-sabene-portrait.png" alt="" widths={[80]} sizes="32px" class="avatar" />
            {d.author}
          </a>
          <span>{fmtDate(d.date, lang)}{d.readingTime ? ` · ${d.readingTime} ${t.minRead}` : ''}</span>
        </p>
        <h1>{d.title}</h1>
        <div class="prose post-body"><Content /></div>
      </div>
    </article>
    {recent.length > 0 && (
      <section class="wrap recent">
        <div class="recent-head"><h2>{t.recentPosts}</h2><a href={localize('/blog', lang)}>{t.seeAll}</a></div>
        <div class="recent-grid">{recent.map((p) => <PostCard post={p} lang={lang} compact />)}</div>
      </section>
    )}
  </div>
</Base>
<style>
  .blog { background: #f6f6f6; padding-bottom: 60px; }
  .post-inner { background: #fff; border: 1px solid #e3e3e3; padding: 50px 98px 60px; }
  .meta { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--gray); margin: 0 0 30px; }
  .author { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .author :global(.avatar) { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: #ddd; }
  h1 { font: 400 clamp(26px, 3.4vw, 36px)/1.3 var(--text); color: var(--ink); margin: 0 0 30px; }
  .post-body { font-size: 17px; line-height: 1.8; color: var(--ink); }
  .post-body :global(img) { width: 100%; height: auto; margin: 10px 0 0; }
  .post-body :global(p:has(> img) + p > em:only-child) { display: block; text-align: center; font-size: 14px; color: var(--gray); }
  .post-body :global(.video) { margin: 1.6em 0; }
  .recent { margin-top: 40px; }
  .recent-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
  .recent-head h2 { font: 400 18px var(--text); margin: 0; }
  .recent-head a { font-size: 14px; color: var(--ink); }
  .recent-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 860px) {
    .post-inner { padding: 28px 18px 40px; margin-inline: calc(-1 * var(--gutter)); border-inline: 0; }
    .recent-grid { grid-template-columns: 1fr; }
  }
</style>
