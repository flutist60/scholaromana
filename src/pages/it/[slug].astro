---
import { getCollection } from 'astro:content';
import PageView from '../../views/PageView.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (e) => e.id.startsWith('it/'));
  return pages.map((entry) => ({ params: { slug: entry.id.split('/')[1] }, props: { entry } }));
}
const { entry } = Astro.props;
---
<PageView entry={entry} lang="it" />
