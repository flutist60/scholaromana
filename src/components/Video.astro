---
/** Privacy friendly YouTube embed: loads the player only on click. */
interface Props { id: string; title?: string }
const { id, title = 'Video' } = Astro.props;
---
<div class="video yt" data-yt={id}>
  <button type="button" class="yt-play" aria-label={`Play: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <span class="yt-icon" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg>
    </span>
  </button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.dataset.yt;
      el.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="YouTube video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`;
    });
  });
</script>
<style>
  .yt-play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: #000; cursor: pointer; }
  .yt-play img { width: 100%; height: 100%; object-fit: cover; opacity: 0.92; transition: opacity 0.2s; }
  .yt-play:hover img { opacity: 1; }
  .yt-icon { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); filter: drop-shadow(0 2px 6px rgba(0,0,0,.4)); }
</style>
